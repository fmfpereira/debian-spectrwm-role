# debian spectrwm xsessionrc script.

# EXTEND WITH THE .PROFILE SETTINGS
if [ -r ~/.profile ]; then 
  . ~/.profile;
fi

# AUTORUN XAUTOLOCK
xautolock -time 10 -locker blurlock &

# AUTORUN SCREEN LAYOUT SCRIPT
if [ -f ~/Scripts/screen-layout ]; then
  bash ~/Scripts/screen-layout &
fi

# AUTORUN XCOMPOSE
setxkbmap -option "compose:ralt"

# AUTORUN NITROGEN SCRIPT
if [ -f ~/Scripts/nitrogen-update ]; then
  # GET PID OF EXISTING PROCESS
  pid=$(pidof --single-shot nitrogen-update)
  # EXECUTE IF PROCESS IS NOT RUNNING
  if [ -z $pid]; then
    # WAIT BEFORE EXECUTING THE SCRIPT
    sleep 2
    bash ~/Scripts/nitrogen-update &
  fi
fi
